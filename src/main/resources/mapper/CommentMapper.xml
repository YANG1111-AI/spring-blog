<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zcy.dao.CommentMapper">
    
    <resultMap id="CommentResultMap" type="com.zcy.domain.Comment">
        <id column="id" property="id"/>
        <result column="article_id" property="articleId"/>
        <result column="content" property="content"/>
        <result column="created" property="created"/>
        <result column="author" property="author"/>
        <result column="ip" property="ip"/>
        <result column="status" property="status"/>
    </resultMap>
    
    <!-- 根据文章ID查询评论列表 -->
    <select id="selectCommentsByArticleId" resultMap="CommentResultMap">
        SELECT * FROM t_comment
        WHERE article_id = #{articleId} AND status = 'approved'
        ORDER BY created DESC
    </select>
    
    <!-- 插入评论 -->
    <insert id="insertComment" parameterType="com.zcy.domain.Comment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_comment (article_id, content, created, author, ip, status)
        VALUES (#{articleId}, #{content}, #{created}, #{author}, #{ip}, #{status})
    </insert>
    
    <!-- 统计评论总数 -->
    <select id="countComment" resultType="int">
        SELECT COUNT(*) FROM t_comment WHERE status = 'approved'
    </select>
    
    <!-- 根据文章ID统计评论数 -->
    <select id="countCommentByArticleId" resultType="int">
        SELECT COUNT(*) FROM t_comment
        WHERE article_id = #{articleId} AND status = 'approved'
    </select>
    
    <!-- 查询所有评论（用于后台管理） -->
    <select id="selectAllComments" resultMap="CommentResultMap">
        SELECT * FROM t_comment
        ORDER BY created DESC
    </select>
    
    <!-- 根据ID查询评论 -->
    <select id="selectCommentById" resultMap="CommentResultMap">
        SELECT * FROM t_comment WHERE id = #{id}
    </select>
    
    <!-- 更新评论 -->
    <update id="updateComment" parameterType="com.zcy.domain.Comment">
        UPDATE t_comment 
        SET content = #{content}, 
            author = #{author}, 
            status = #{status}
        WHERE id = #{id}
    </update>
    
    <!-- 删除评论 -->
    <delete id="deleteComment">
        DELETE FROM t_comment WHERE id = #{id}
    </delete>

</mapper>

