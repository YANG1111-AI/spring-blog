<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zcy.dao.UserProfileMapper">

    <!-- 结果映射 -->
    <resultMap id="userProfileResultMap" type="com.zcy.domain.UserProfile">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="bio" column="bio"/>
        <result property="website" column="website"/>
        <result property="location" column="location"/>
        <result property="birthday" column="birthday"/>
        <result property="gender" column="gender"/>
        <result property="created" column="created"/>
        <result property="modified" column="modified"/>
        <association property="user" javaType="com.zcy.domain.User">
            <id property="id" column="user_id"/>
            <result property="username" column="username"/>
            <result property="email" column="email"/>
            <result property="created" column="user_created"/>
            <result property="articlesCount" column="articles_count"/>
            <result property="commentsCount" column="comments_count"/>
        </association>
    </resultMap>

    <!-- 根据用户ID查询个人资料 -->
    <select id="selectProfileByUserId" resultMap="userProfileResultMap">
        SELECT up.*, u.username, u.email, u.created as user_created, u.articles_count, u.comments_count
        FROM t_user_profile up
        LEFT JOIN t_user u ON up.user_id = u.id
        WHERE up.user_id = #{userId}
    </select>

    <!-- 插入个人资料 -->
    <insert id="insertProfile" parameterType="com.zcy.domain.UserProfile" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user_profile (user_id, nickname, avatar, bio, website, location, birthday, gender, created, modified)
        VALUES (#{userId}, #{nickname}, #{avatar}, #{bio}, #{website}, #{location}, #{birthday}, #{gender}, #{created}, #{modified})
    </insert>

    <!-- 更新个人资料 -->
    <update id="updateProfile" parameterType="com.zcy.domain.UserProfile">
        UPDATE t_user_profile SET
            <if test="nickname != null and nickname != ''">
                nickname = #{nickname},
            </if>
            <if test="nickname == null or nickname == ''">
                nickname = NULL,
            </if>
            <if test="avatar != null and avatar != ''">
                avatar = #{avatar},
            </if>
            <if test="avatar == null or avatar == ''">
                avatar = NULL,
            </if>
            <if test="bio != null and bio != ''">
                bio = #{bio},
            </if>
            <if test="bio == null or bio == ''">
                bio = NULL,
            </if>
            <if test="website != null and website != ''">
                website = #{website},
            </if>
            <if test="website == null or website == ''">
                website = NULL,
            </if>
            <if test="location != null and location != ''">
                location = #{location},
            </if>
            <if test="location == null or location == ''">
                location = NULL,
            </if>
            <if test="birthday != null">
                birthday = #{birthday},
            </if>
            <if test="birthday == null">
                birthday = NULL,
            </if>
            <if test="gender != null">
                gender = #{gender},
            </if>
            <if test="gender == null">
                gender = NULL,
            </if>
            modified = NOW()
        WHERE user_id = #{userId}
    </update>

    <!-- 删除个人资料 -->
    <delete id="deleteProfile">
        DELETE FROM t_user_profile WHERE user_id = #{userId}
    </delete>

</mapper>