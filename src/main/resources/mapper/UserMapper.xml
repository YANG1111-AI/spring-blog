<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zcy.dao.UserMapper">

    <!-- 结果映射 -->
    <resultMap id="userResultMap" type="com.zcy.domain.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="created" column="created"/>
        <result property="valid" column="valid"/>
        <collection property="authorities" ofType="com.zcy.domain.Authority"
                    select="selectAuthoritiesByUserId" column="id"/>
    </resultMap>

    <!-- 根据用户名查询用户 -->
    <select id="selectUserByUsername" parameterType="String" resultMap="userResultMap">
        SELECT * FROM t_user WHERE username = #{username} AND valid = 1
    </select>

    <!-- 根据邮箱查询用户 -->
    <select id="selectUserByEmail" parameterType="String" resultType="com.zcy.domain.User">
        SELECT * FROM t_user WHERE email = #{email} AND valid = 1
    </select>

    <!-- 插入用户 -->
    <insert id="insertUser" parameterType="com.zcy.domain.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user (username, password, email, created, valid)
        VALUES (#{username}, #{password}, #{email}, #{created}, #{valid})
    </insert>

    <!-- 查询用户的权限列表 -->
    <select id="selectAuthoritiesByUserId" parameterType="Integer" resultType="com.zcy.domain.Authority">
        SELECT a.id, a.authority
        FROM t_authority a
        INNER JOIN t_user_authority ua ON a.id = ua.authority_id
        WHERE ua.user_id = #{userId}
    </select>

    <!-- 插入用户权限关联 -->
    <insert id="insertUserAuthority">
        INSERT INTO t_user_authority (user_id, authority_id)
        VALUES (#{userId}, #{authorityId})
    </insert>

    <!-- 查询所有用户 -->
    <select id="selectAllUsers" resultMap="userResultMap">
        SELECT * FROM t_user ORDER BY created DESC
    </select>

    <!-- 根据ID查询用户（管理员用，不限制valid状态） -->
    <select id="selectUserById" parameterType="Integer" resultMap="userResultMap">
        SELECT * FROM t_user WHERE id = #{id}
    </select>

    <!-- 更新用户信息 -->
    <update id="updateUser" parameterType="com.zcy.domain.User">
        UPDATE t_user SET
            email = #{email},
            valid = #{valid}
            <if test="password != null and password != ''">
                , password = #{password}
            </if>
        WHERE id = #{id}
    </update>

    <!-- 删除用户 -->
    <delete id="deleteUser" parameterType="Integer">
        DELETE FROM t_user WHERE id = #{id}
    </delete>

</mapper>

